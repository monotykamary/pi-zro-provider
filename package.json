{
  "name": "pi-zro-provider",
  "version": "1.3.9",
  "description": "Zro provider extension for pi - GLM-5.2, GLM-5.3 Flash, Kimi K3 & DeepSeek V4 Flash through the Zro inference endpoint",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "clean": "echo 'nothing to clean'",
    "build": "echo 'nothing to build'",
    "check": "tsc --noEmit && node tests/status.smoke.ts",
    "smoke": "node tests/status.smoke.ts",
    "update-models": "node scripts/update-models.js"
  },
  "keywords": [
    "pi",
    "extension",
    "provider",
    "zro",
    "moonmath",
    "glm",
    "kimi",
    "deepseek",
    "glm-5.2",
    "glm-5.3-flash",
    "ai",
    "llm"
  ],
  "author": "",
  "license": "MIT",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.85.0",
    "@earendil-works/pi-coding-agent": "0.85.0",
    "@types/node": "^24.10.1",
    "typescript": "6.0.3"
  }
}
